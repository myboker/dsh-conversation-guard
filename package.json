  },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test",
    "test:live": "tsx scripts/live-eval.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
