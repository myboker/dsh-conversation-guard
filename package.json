  "homepage": "https://github.com/myboker/dsh-conversation-guard#readme",
  "bugs": {
    "url": "https://github.com/myboker/dsh-conversation-guard/issues"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "conversation-guard", "multi-agent", "handoff"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.0.0",
