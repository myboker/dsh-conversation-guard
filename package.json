    "@deepseek-ai/dsh-user-questions": "0.2.2-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-commands": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "@deepseek-ai/dsh-user-questions": "0.2.2-alpha.3"
  }
